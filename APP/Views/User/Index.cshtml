@model List<BAL.DTOs.UserDTO>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        <i class="fa-solid fa-users me-2" style="color:#ff6b35"></i>Manage Users
    </h2>
    <div>
        <a asp-action="Create" class="btn btn-success me-2">
            <i class="fa-solid fa-plus me-1"></i> Add User
        </a>
        <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- ✅ Search Bar -->
<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">
        <span class="input-group-text" style="background:#ff6b35; color:white;">
            <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control" placeholder="Search by name, email or role..." />
        <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
        </button>
        @if (ViewBag.Search != null)
        {
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-xmark me-1"></i> Clear
            </a>
        }
    </div>
</form>

<!-- Search Result Count -->
@if (ViewBag.Search != null)
{
    <p class="text-muted mb-3">
        <i class="fa-solid fa-circle-info me-1"></i>
        Found <strong>@Model.Count</strong> result(s) for "@ViewBag.Search"
    </p>
}

<table class="table table-bordered table-hover">
    <thead style="background:#ff6b35; color:white;">
        <tr>
            <th><i class="fa-solid fa-hashtag me-1"></i>ID</th>
            <th><i class="fa-solid fa-user me-1"></i>Name</th>
            <th><i class="fa-solid fa-envelope me-1"></i>Email</th>
            <th><i class="fa-solid fa-shield-halved me-1"></i>Role</th>
            <th><i class="fa-solid fa-gear me-1"></i>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="fa-solid fa-face-frown fa-2x mb-2 d-block"></i>
                    No users found for "@ViewBag.Search"
                </td>
            </tr>
        }
        else
        {
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Role.ToLower() == "admin")
                        {
                            <span class="badge" style="background:#ff6b35">
                                <i class="fa-solid fa-crown me-1"></i>Admin
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                <i class="fa-solid fa-user me-1"></i>Customer
                            </span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id"
                               class="btn btn-warning btn-sm">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@user.Id"
                               class="btn btn-danger btn-sm">
                            <i class="fa-solid fa-trash me-1"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>