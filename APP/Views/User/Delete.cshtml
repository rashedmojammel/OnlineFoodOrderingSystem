@model BAL.DTOs.UserDTO
@{
    ViewData["Title"] = "Delete User";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 border-danger" style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.1)">
            <h2 class="mb-4 text-danger">🗑️ Delete User</h2>
            <p class="text-muted">Are you sure you want to delete this user?</p>

            <table class="table table-bordered mb-4">
                <tr>
                    <th>ID</th>
                    <td>@Model.Id</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.Email</td>
                </tr>
                <tr>
                    <th>Role</th>
                    <td>@Model.Role</td>
                </tr>
            </table>

            <form method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex gap-2">
                    <button type="submit" name="Decision" value="Yes" class="btn btn-danger w-100">
                        ✅ Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-100"/>
                        ❌ No, Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>