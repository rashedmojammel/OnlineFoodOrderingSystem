<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Foodyy</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
            body {
                background: #fff8f5;
            }

            .navbar {
                background: #ff6b35;
            }

            .navbar-brand,
            .nav-link {
                color: white !important;
                font-weight: 600;
            }

            footer {
                background: #222;
                color: white;
                padding: 20px;
                text-align: center;
                margin-top: 50px;
            }
    </style>
</head>
<body>

    <div class="hero-section text-white text-center py-5 mb-5 rounded-3"
         style="background: linear-gradient(135deg, #ff6b35, #f7931e);">
        <div class="container py-4">
            <h1 class="display-4 fw-bold mb-3">
                <i class="fa-solid fa-burger me-3"></i>Delicious Food
            </h1>
            <p class="lead mb-4">
                Order your favourite meals and get them delivered hot & fresh to your door 🚀
            </p>
            @if (Context.Session.GetString("UserName") == null)
            {
                <a asp-controller="Account" asp-action="Register"
                       class="btn btn-light btn-lg me-3 fw-bold" style="color:#ff6b35">
                    <i class="fa-solid fa-user-plus me-2"></i>Get Started
                </a>
                <a asp-controller="Account" asp-action="Login"
                       class="btn btn-outline-light btn-lg fw-bold">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Login
                </a>
            }
            else
            {
                @if (Context.Session.GetString("UserRole").ToLower() == "admin")
                {
                    <a asp-controller="AdminDashboard" asp-action="Index"
                           class="btn btn-light btn-lg fw-bold" style="color:#ff6b35">
                        <i class="fa-solid fa-gauge me-2"></i>Go to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Menu" asp-action="Index"
                           class="btn btn-light btn-lg fw-bold" style="color:#ff6b35">
                        <i class="fa-solid fa-utensils me-2"></i>Order Now
                    </a>
                }
            }
        </div>
    </div>

    <!-- FEATURES SECTION -->
    <div class="container mb-5">
        <h2 class="text-center fw-bold mb-4">
            Why Choose <span style="color:#ff6b35">FoodOrder?</span>
        </h2>
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="card h-100 p-4 border-0"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
                    <div class="mb-3">
                        <i class="fa-solid fa-bolt fa-3x" style="color:#ff6b35"></i>
                    </div>
                    <h5 class="fw-bold">Fast Delivery</h5>
                    <p class="text-muted">
                        Get your food delivered in under 30 minutes. Fresh and hot every time.
                    </p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 p-4 border-0"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
                    <div class="mb-3">
                        <i class="fa-solid fa-star fa-3x" style="color:#ff6b35"></i>
                    </div>
                    <h5 class="fw-bold">Top Quality</h5>
                    <p class="text-muted">
                        Only the freshest ingredients used in every meal we prepare for you.
                    </p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 p-4 border-0"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
                    <div class="mb-3">
                        <i class="fa-solid fa-tag fa-3x" style="color:#ff6b35"></i>
                    </div>
                    <h5 class="fw-bold">Best Prices</h5>
                    <p class="text-muted">
                        Affordable prices with exclusive deals and discounts every day.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- POPULAR CATEGORIES -->
    <div class="container mb-5">
        <h2 class="text-center fw-bold mb-4">
            Popular <span style="color:#ff6b35">Categories</span>
        </h2>
        <div class="row text-center">
            <div class="col-6 col-md-3 mb-4">
                <div class="card p-4 border-0 h-100"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08); cursor:pointer"
                     onmouseover="this.style.background='#ff6b35'; this.style.color='white'"
                     onmouseout="this.style.background='white'; this.style.color='black'">
                    <i class="fa-solid fa-burger fa-3x mb-3" style="color:#ff6b35"></i>
                    <h6 class="fw-bold">Burgers</h6>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-4">
                <div class="card p-4 border-0 h-100"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08); cursor:pointer"
                     onmouseover="this.style.background='#ff6b35'; this.style.color='white'"
                     onmouseout="this.style.background='white'; this.style.color='black'">
                    <i class="fa-solid fa-pizza-slice fa-3x mb-3" style="color:#ff6b35"></i>
                    <h6 class="fw-bold">Pizza</h6>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-4">
                <div class="card p-4 border-0 h-100"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08); cursor:pointer"
                     onmouseover="this.style.background='#ff6b35'; this.style.color='white'"
                     onmouseout="this.style.background='white'; this.style.color='black'">
                    <i class="fa-solid fa-drumstick-bite fa-3x mb-3" style="color:#ff6b35"></i>
                    <h6 class="fw-bold">Chicken</h6>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-4">
                <div class="card p-4 border-0 h-100"
                     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08); cursor:pointer"
                     onmouseover="this.style.background='#ff6b35'; this.style.color='white'"
                     onmouseout="this.style.background='white'; this.style.color='black'">
                    <i class="fa-solid fa-ice-cream fa-3x mb-3" style="color:#ff6b35"></i>
                    <h6 class="fw-bold">Desserts</h6>
                </div>
            </div>
        </div>
    </div>

    <!-- HOW IT WORKS -->
    <div class="container mb-5">
        <h2 class="text-center fw-bold mb-4">
            How It <span style="color:#ff6b35">Works?</span>
        </h2>
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="mb-3">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                          style="width:60px; height:60px; background:#ff6b35; color:white; font-size:24px; font-weight:bold">
                        1
                    </span>
                </div>
                <h5 class="fw-bold">Choose Food</h5>
                <p class="text-muted">Browse our menu and pick your favourite meals</p>
            </div>
            <div class="col-md-4 mb-4">
                <div class="mb-3">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                          style="width:60px; height:60px; background:#ff6b35; color:white; font-size:24px; font-weight:bold">
                        2
                    </span>
                </div>
                <h5 class="fw-bold">Place Order</h5>
                <p class="text-muted">Add items to cart and checkout easily</p>
            </div>
            <div class="col-md-4 mb-4">
                <div class="mb-3">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                          style="width:60px; height:60px; background:#ff6b35; color:white; font-size:24px; font-weight:bold">
                        3
                    </span>
                </div>
                <h5 class="fw-bold">Enjoy Food</h5>
                <p class="text-muted">Get your food delivered hot and fresh to your door</p>
            </div>
        </div>
    </div>

    <!-- CALL TO ACTION -->
    @if (Context.Session.GetString("UserName") == null)
    {
        <div class="text-white text-center py-5 rounded-3 mb-5"
             style="background: linear-gradient(135deg, #ff6b35, #f7931e);">
            <h2 class="fw-bold mb-3">Ready to Order? 🍔</h2>
            <p class="lead mb-4">Join thousands of happy customers today!</p>
            <a asp-controller="Account" asp-action="Register"
                   class="btn btn-light btn-lg fw-bold me-3" style="color:#ff6b35">
                <i class="fa-solid fa-user-plus me-2"></i>Register Now
            </a>
            <a asp-controller="Account" asp-action="Login"
                   class="btn btn-outline-light btn-lg fw-bold">
                <i class="fa-solid fa-right-to-bracket me-2"></i>Login
            </a>
        </div>
    }

</body>
</html>