@* APP/Views/Notification/Index.cshtml *@
@model List<BAL.DTOs.NotificationDTO>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
        <i class="fa-solid fa-bell me-2" style="color:#ff6b35"></i>
        Notifications
    </h2>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="fa-solid fa-bell-slash fa-4x mb-3 d-block text-muted"></i>
        <h4 class="text-muted">No notifications</h4>
    </div>
}
else
{
    @foreach (var n in Model)
    {
        <div class="card border-0 mb-3"
             style="border-radius:12px;
            box-shadow:0 2px 15px rgba(0,0,0,0.06);
            border-left: 4px solid @(n.IsRead == true ? "#dee2e6" : "#ff6b35") !important">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div class="d-flex gap-3">
                    <div class="rounded-circle d-flex align-items-center
                        justify-content-center flex-shrink-0"
                         style="width:45px; height:45px;
                        background:@(n.IsRead == true ? "#f8f9fa" : "#fff3ee")">
                        <i class="fa-solid fa-bell"
                           style="color:@(n.IsRead == true ? "#aaa" : "#ff6b35")"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">@n.Title</h6>
                        <p class="text-muted mb-1 small">@n.Message</p>
                        <small class="text-muted">
                            <i class="fa-solid fa-clock me-1"></i>
                            @n.CreatedAt?.ToString("dd MMM yyyy hh:mm tt")
                        </small>
                    </div>
                </div>
                <div class="d-flex gap-2 ms-3">
                    @if (n.IsRead == false)
                    {
                        <a asp-action="MarkRead" asp-route-id="@n.Id"
                               class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-check"></i>
                        </a>
                    }
                    <a asp-action="Delete" asp-route-id="@n.Id"
                           class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </div>
            </div>
        </div>
    }
}