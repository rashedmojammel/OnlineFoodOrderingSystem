@model BAL.DTOs.CategoryDTO
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 p-4"
             style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.1)">
            <h2 class="fw-bold mb-4">
                <i class="fa-solid fa-plus me-2" style="color:#ff6b35"></i>
                Create Category
            </h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-tag me-1" style="color:#ff6b35"></i>
                        Category Name
                    </label>
                    <input asp-for="Name" class="form-control"
                           placeholder="e.g. Burger, Pizza, Drinks" />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-align-left me-1"
                           style="color:#ff6b35"></i>Description
                    </label>
                    <textarea asp-for="Description" class="form-control"
                              rows="3"
                              placeholder="Short description (optional)"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Create Category
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="fa-solid fa-xmark me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>