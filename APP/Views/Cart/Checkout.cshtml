@* APP/Views/Cart/Checkout.cshtml *@
@model BAL.DTOs.CheckoutDTO
@{
    ViewData["Title"] = "Checkout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 p-4"
             style="border-radius:15px;
            box-shadow:0 4px 20px rgba(0,0,0,0.1)">
            <h2 class="fw-bold mb-4">
                <i class="fa-solid fa-credit-card me-2"
                   style="color:#ff6b35"></i>Checkout
            </h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <!-- Order Total -->
            <div class="card mb-4 border-0"
                 style="background:#f8f9fa; border-radius:10px">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="fa-solid fa-receipt me-2"
                           style="color:#ff6b35"></i>Order Summary
                    </h6>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Total Amount</span>
                        <strong style="color:#ff6b35; font-size:20px">
                            ৳@Model.Total
                        </strong>
                    </div>
                </div>
            </div>

            <form method="post">
                <input asp-for="Total" type="hidden" />

                <!-- Payment Method Selection -->
                <div class="mb-4">
                    <label class="form-label fw-bold">
                        <i class="fa-solid fa-wallet me-1"
                           style="color:#ff6b35"></i>
                        Select Payment Method
                    </label>

                    <!-- Cash on Delivery -->
                    <div class="card mb-2 border-2 payment-option"
                         style="border-radius:10px; cursor:pointer"
                         onclick="selectPayment('Cash on Delivery', this)">
                        <div class="card-body d-flex align-items-center gap-3 py-3">
                            <input type="radio" name="PaymentMethod"
                                   value="Cash on Delivery"
                                   id="cod" checked />
                            <label for="cod" class="mb-0"
                                   style="cursor:pointer">
                                <i class="fa-solid fa-money-bill fa-lg me-2"
                                   style="color:#28a745"></i>
                                <strong>Cash on Delivery</strong>
                                <div class="text-muted small">
                                    Pay when your order arrives
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- bKash -->
                    <div class="card mb-2 border-2 payment-option"
                         style="border-radius:10px; cursor:pointer"
                         onclick="selectPayment('bKash', this)">
                        <div class="card-body d-flex align-items-center gap-3 py-3">
                            <input type="radio" name="PaymentMethod"
                                   value="bKash" id="bkash" />
                            <label for="bkash" class="mb-0"
                                   style="cursor:pointer">
                                <i class="fa-solid fa-mobile-screen fa-lg me-2"
                                   style="color:#E2136E"></i>
                                <strong>bKash</strong>
                                <div class="text-muted small">
                                    Pay via bKash mobile banking
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Nagad -->
                    <div class="card mb-2 border-2 payment-option"
                         style="border-radius:10px; cursor:pointer"
                         onclick="selectPayment('Nagad', this)">
                        <div class="card-body d-flex align-items-center gap-3 py-3">
                            <input type="radio" name="PaymentMethod"
                                   value="Nagad" id="nagad" />
                            <label for="nagad" class="mb-0"
                                   style="cursor:pointer">
                                <i class="fa-solid fa-mobile-screen fa-lg me-2"
                                   style="color:#F6A024"></i>
                                <strong>Nagad</strong>
                                <div class="text-muted small">
                                    Pay via Nagad mobile banking
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Card -->
                    <div class="card mb-2 border-2 payment-option"
                         style="border-radius:10px; cursor:pointer"
                         onclick="selectPayment('Card', this)">
                        <div class="card-body d-flex align-items-center gap-3 py-3">
                            <input type="radio" name="PaymentMethod"
                                   value="Card" id="card" />
                            <label for="card" class="mb-0"
                                   style="cursor:pointer">
                                <i class="fa-solid fa-credit-card fa-lg me-2"
                                   style="color:#007bff"></i>
                                <strong>Credit / Debit Card</strong>
                                <div class="text-muted small">
                                    Pay via Visa or Mastercard
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit"
                        class="btn w-100 text-white fw-bold py-3"
                        style="background:#ff6b35; border-radius:10px">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    Place Order — ৳@Model.Total
                </button>

                <a asp-controller="Cart" asp-action="Index"
                       class="btn btn-outline-secondary w-100 mt-2">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Cart
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectPayment(method, card) {
            // Remove selected style from all
            document.querySelectorAll('.payment-option').forEach(c => {
                c.style.borderColor = '#dee2e6';
                c.style.background = 'white';
            });
            // Highlight selected
            card.style.borderColor = '#ff6b35';
            card.style.background = '#fff3ee';
            // Check the radio
            card.querySelector('input[type=radio]').checked = true;
        }

        // Highlight Cash on Delivery by default
        document.addEventListener('DOMContentLoaded', () => {
            const first = document.querySelector('.payment-option');
            if (first) {
                first.style.borderColor = '#ff6b35';
                first.style.background = '#fff3ee';
            }
        });
    </script>
}