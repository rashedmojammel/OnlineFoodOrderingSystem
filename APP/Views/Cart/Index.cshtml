@model List<BAL.DTOs.CartItemDTO>
@{
    ViewData["Title"] = "My Cart";
}

<h2 class="fw-bold mb-4">
    <i class="fa-solid fa-cart-shopping me-2" style="color:#ff6b35"></i>My Cart
</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4"
         role="alert" style="border-radius:12px; border-left: 4px solid #28a745;">
        <i class="fa-solid fa-circle-check me-2 fs-5"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="fa-solid fa-cart-shopping fa-4x mb-3 d-block text-muted"></i>
        <h4 class="text-muted">Your cart is empty</h4>
        <a asp-controller="Menu" asp-action="Index"
               class="btn mt-3 text-white" style="background:#ff6b35">
            <i class="fa-solid fa-utensils me-1"></i> Browse Menu
        </a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="card border-0"
                 style="border-radius:15px;
                box-shadow:0 4px 20px rgba(0,0,0,0.08)">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead style="background:#ff6b35; color:white;">
                            <tr>
                                <th class="ps-4">
                                    <i class="fa-solid fa-burger me-1"></i>Item
                                </th>
                                <th>
                                    <i class="fa-solid fa-money-bill me-1"></i>Price
                                </th>
                                <th>
                                    <i class="fa-solid fa-hashtag me-1"></i>Quantity
                                </th>
                                <th>
                                    <i class="fa-solid fa-calculator me-1"></i>Total
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.FoodName</td>
                                    <td>৳@item.Price</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-action="Decrease"
                                                   asp-route-foodId="@item.FoodId"
                                                   class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid fa-minus"></i>
                                            </a>
                                            <span class="fw-bold">@item.Quantity</span>
                                            <a asp-action="Increase"
                                                   asp-route-foodId="@item.FoodId"
                                                   class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid fa-plus"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <td class="fw-bold" style="color:#ff6b35">
                                        ৳@item.Total
                                    </td>
                                    <td>
                                        <a asp-action="Remove"
                                               asp-route-foodId="@item.FoodId"
                                               class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <a asp-action="Clear" class="btn btn-outline-danger mt-3">
                <i class="fa-solid fa-trash me-1"></i> Clear Cart
            </a>
            <a asp-controller="Menu" asp-action="Index"
                   class="btn btn-outline-secondary mt-3 ms-2">
                <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
            </a>
        </div>

        <!-- Order Summary -->
        <div class="col-md-4">
            <div class="card border-0"
                 style="border-radius:15px;
                box-shadow:0 4px 20px rgba(0,0,0,0.08)">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="fa-solid fa-receipt me-2"
                           style="color:#ff6b35"></i>Order Summary
                    </h5>
                    <hr />
                    @foreach (var item in Model)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">
                                @item.FoodName : @item.Quantity
                            </span>
                            <span>৳@item.Total</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span style="color:#ff6b35">
                            ৳@Model.Sum(i => i.Total)
                        </span>
                    </div>
                    <form method="post" asp-action="Checkout" class="mt-3">
                        <a asp-action="Checkout"
                               class="btn w-100 text-white fw-bold py-3"
                               style="background:#ff6b35; border-radius:10px">
                            <i class="fa-solid fa-credit-card me-2"></i>
                            Proceed to Checkout
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
}