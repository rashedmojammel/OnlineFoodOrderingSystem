@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Foodyy</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #fff8f5;
            font-family: 'DM Sans', sans-serif;
            color: #1a0a00;
        }

        /* ── NAVBAR ── */
        .fo-nav {
            background: #fff8f5;
            border-bottom: 1px solid rgba(0,0,0,0.07);
            padding: 16px 0;
        }
        .fo-nav .brand {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 700;
            color: #d85a30;
            text-decoration: none;
        }
        .fo-nav .brand i { margin-right: 8px; }

        /* ── HERO ── */
        .fo-hero {
            background: #1a0a00;
            border-radius: 20px;
            overflow: hidden;
            padding: 72px 56px 64px;
            margin-bottom: 56px;
            position: relative;
        }
        .fo-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse at 72% 50%, rgba(210,90,30,0.40) 0%, transparent 60%),
                radial-gradient(ellipse at 18% 80%, rgba(240,153,123,0.18) 0%, transparent 55%);
            pointer-events: none;
        }
        .fo-hero > * { position: relative; z-index: 1; }

        .fo-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(216,90,48,0.18);
            border: 0.5px solid rgba(216,90,48,0.45);
            color: #f0997b;
            font-size: 11px;
            font-weight: 500;
            padding: 5px 15px;
            border-radius: 999px;
            margin-bottom: 28px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .fo-badge-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #f0997b;
            flex-shrink: 0;
        }

        .fo-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(38px, 5.5vw, 62px);
            font-weight: 700;
            color: #fff;
            line-height: 1.1;
            margin-bottom: 20px;
        }
        .fo-hero h1 span { color: #f0997b; }

        .fo-hero p.lead {
            color: rgba(255,255,255,0.58);
            font-size: 16px;
            font-weight: 300;
            line-height: 1.75;
            max-width: 420px;
            margin-bottom: 40px;
        }

        .fo-btn-primary {
            background: #d85a30;
            color: #fff;
            border: none;
            padding: 14px 30px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background 0.2s;
        }
        .fo-btn-primary:hover { background: #c44f27; color: #fff; }

        .fo-btn-secondary {
            background: transparent;
            color: rgba(255,255,255,0.72);
            border: 0.5px solid rgba(255,255,255,0.28);
            padding: 14px 30px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 400;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: border-color 0.2s, color 0.2s;
        }
        .fo-btn-secondary:hover { border-color: rgba(255,255,255,0.55); color: #fff; }

        /* Floating pills */
        .fo-floater {
            position: absolute;
            right: 56px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 1;
        }
        .fo-pill {
            background: rgba(255,255,255,0.07);
            border: 0.5px solid rgba(255,255,255,0.13);
            border-radius: 999px;
            padding: 10px 20px;
            color: rgba(255,255,255,0.65);
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 9px;
            white-space: nowrap;
            backdrop-filter: blur(4px);
        }
        .fo-pill-dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ── SECTION LABEL ── */
        .fo-section-label {
            font-size: 11px;
            font-weight: 500;
            color: #d85a30;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .fo-section-title {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            font-weight: 700;
            color: #1a0a00;
            margin-bottom: 32px;
            line-height: 1.25;
        }

        /* ── FEATURE CARDS ── */
        .fo-card {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.07);
            border-radius: 16px;
            padding: 32px 26px;
            height: 100%;
            transition: transform 0.25s, box-shadow 0.25s;
        }
        .fo-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(216,90,48,0.10);
        }
        .fo-card-icon {
            width: 48px; height: 48px;
            border-radius: 12px;
            background: #fae8df;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            font-size: 20px;
            color: #d85a30;
        }
        .fo-card h5 {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 8px;
            color: #1a0a00;
        }
        .fo-card p {
            font-size: 14px;
            color: #7a5c50;
            line-height: 1.65;
            margin: 0;
        }

        /* ── STATS ── */
        .fo-stats-row {
            border-top: 1px solid rgba(0,0,0,0.07);
            border-bottom: 1px solid rgba(0,0,0,0.07);
            padding: 40px 0;
            margin: 56px 0;
        }
        .fo-stat-num {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #d85a30;
            line-height: 1;
            margin-bottom: 6px;
        }
        .fo-stat-label {
            font-size: 13px;
            color: #7a5c50;
            font-weight: 400;
        }

        /* ── FOOTER ── */
        .fo-footer {
            background: #1a0a00;
            color: rgba(255,255,255,0.45);
            text-align: center;
            padding: 28px;
            font-size: 13px;
            border-radius: 20px 20px 0 0;
            margin-top: 40px;
        }
        .fo-footer span { color: #f0997b; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .fo-hero { padding: 48px 28px 200px; }
            .fo-floater { position: static; transform: none; flex-direction: row; flex-wrap: wrap; margin-top: 32px; }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="fo-nav">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="/" class="brand">
                <i class="fa-solid fa-burger"></i>Foodyy
            </a>
            <div class="d-flex gap-2">
                @if (Context.Session.GetString("UserName") == null)
                {
                    <a asp-controller="Account" asp-action="Login"
                       class="fo-btn-secondary" style="padding: 9px 22px; font-size: 14px; color: #7a5c50; border-color: rgba(0,0,0,0.15);">
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="fo-btn-primary" style="padding: 9px 22px; font-size: 14px;">
                        Get Started
                    </a>
                }
                else
                {
                    <span style="font-size:14px; color:#7a5c50; align-self:center;">
                        Hi, @Context.Session.GetString("UserName")
                    </span>
                    @if (Context.Session.GetString("UserRole")?.ToLower() == "admin")
                    {
                        <a asp-controller="AdminDashboard" asp-action="Index"
                           class="fo-btn-primary" style="padding: 9px 22px; font-size: 14px;">
                            <i class="fa-solid fa-gauge"></i> Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Menu" asp-action="Index"
                           class="fo-btn-primary" style="padding: 9px 22px; font-size: 14px;">
                            <i class="fa-solid fa-utensils"></i> Order Now
                        </a>
                    }
                }
            </div>
        </div>
    </nav>

    <div class="container py-4">

        <!-- HERO -->
        <div class="fo-hero">
            <div class="fo-badge">
                <div class="fo-badge-dot"></div>
                Now delivering in your area
            </div>

            <h1>Meals you love,<br><span>delivered fast.</span></h1>

            <p class="lead">
                Order your favourite dishes and get them delivered hot &amp; fresh to your door.
            </p>

            <div class="d-flex gap-3 flex-wrap">
                @if (Context.Session.GetString("UserName") == null)
                {
                    <a asp-controller="Account" asp-action="Register" class="fo-btn-primary">
                        <i class="fa-solid fa-user-plus"></i> Get Started
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="fo-btn-secondary">
                        <i class="fa-solid fa-right-to-bracket"></i> Login
                    </a>
                }
                else
                {
                    @if (Context.Session.GetString("UserRole")?.ToLower() == "admin")
                    {
                        <a asp-controller="AdminDashboard" asp-action="Index" class="fo-btn-primary">
                            <i class="fa-solid fa-gauge"></i> Go to Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Menu" asp-action="Index" class="fo-btn-primary">
                            <i class="fa-solid fa-utensils"></i> Order Now
                        </a>
                    }
                }
            </div>

            <!-- Floating Pills -->
            <div class="fo-floater">
                <div class="fo-pill">
                    <div class="fo-pill-dot" style="background:#4ade80"></div>
                    Delivered in 28 min
                </div>
                <div class="fo-pill">
                    <div class="fo-pill-dot" style="background:#facc15"></div>
                    4.9 ★ average rating
                </div>
                <div class="fo-pill">
                    <div class="fo-pill-dot" style="background:#f0997b"></div>
                    Free delivery today
                </div>
            </div>
        </div>

        <!-- FEATURES -->
        <div class="mb-5">
            <div class="fo-section-label">Why choose us</div>
            <div class="fo-section-title">Built around<br>your cravings.</div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="fo-card">
                        <div class="fo-card-icon">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <h5>Fast Delivery</h5>
                        <p>Under 30 minutes from kitchen to your door, every time.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="fo-card">
                        <div class="fo-card-icon">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <h5>Top Quality</h5>
                        <p>Only the freshest ingredients used in every single meal.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="fo-card">
                        <div class="fo-card-icon">
                            <i class="fa-solid fa-tag"></i>
                        </div>
                        <h5>Best Prices</h5>
                        <p>Affordable bites with exclusive discounts every day.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- STATS -->
        <div class="fo-stats-row">
            <div class="row text-center g-4">
                <div class="col-4">
                    <div class="fo-stat-num">50k+</div>
                    <div class="fo-stat-label">Happy customers</div>
                </div>
                <div class="col-4">
                    <div class="fo-stat-num">200+</div>
                    <div class="fo-stat-label">Menu items</div>
                </div>
                <div class="col-4">
                    <div class="fo-stat-num">28m</div>
                    <div class="fo-stat-label">Avg. delivery</div>
                </div>
            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <footer class="fo-footer">
        <p>© 2026 <span>FoodOrder</span>. All rights reserved.</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
