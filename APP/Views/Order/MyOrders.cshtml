@model List<BAL.DTOs.OrderDTO>
@{
    ViewData["Title"] = "My Orders";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
        <i class="fa-solid fa-box me-2" style="color:#ff6b35"></i>My Orders
    </h2>
    <a asp-controller="Menu" asp-action="Index"
           class="btn text-white" style="background:#ff6b35">
        <i class="fa-solid fa-utensils me-1"></i> Order More
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="fa-solid fa-box-open fa-4x mb-3 d-block text-muted"></i>
        <h4 class="text-muted">No orders yet</h4>
        <p class="text-muted">Browse our menu and place your first order!</p>
        <a asp-controller="Menu" asp-action="Index"
               class="btn mt-2 text-white px-4" style="background:#ff6b35">
            <i class="fa-solid fa-utensils me-1"></i> Browse Menu
        </a>
    </div>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card border-0 mb-4"
             style="border-radius:15px;
            box-shadow:0 4px 20px rgba(0,0,0,0.08)">

            <!-- Order Header -->
            <div class="card-header border-0 d-flex justify-content-between
                align-items-center py-3"
                 style="background:#f8f9fa; border-radius:15px 15px 0 0">
                <div>
                    <h6 class="fw-bold mb-1">
                        <i class="fa-solid fa-receipt me-2"
                           style="color:#ff6b35"></i>
                        Order #@order.Id
                    </h6>
                    <small class="text-muted">
                        <i class="fa-solid fa-calendar me-1"></i>
                        @order.OrderDate?.ToString("dd MMM yyyy — hh:mm tt")
                    </small>
                </div>
                <div class="text-end">
                    @if (order.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">
                            <i class="fa-solid fa-clock me-1"></i>Pending
                        </span>
                    }
                    else if (order.Status == "Preparing")
                    {
                        <span class="badge bg-primary px-3 py-2">
                            <i class="fa-solid fa-fire me-1"></i>Preparing
                        </span>
                    }
                    else if (order.Status == "Delivered")
                    {
                        <span class="badge bg-success px-3 py-2">
                            <i class="fa-solid fa-circle-check me-1"></i>Delivered
                        </span>
                    }
                    else if (order.Status == "Cancelled")
                    {
                        <span class="badge bg-danger px-3 py-2">
                            <i class="fa-solid fa-xmark me-1"></i>Cancelled
                        </span>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="card-body px-4 pt-3 pb-0">
                <table class="table table-sm mb-3">
                    <thead style="background:#fff3ee">
                        <tr>
                            <th class="ps-3">
                                <i class="fa-solid fa-burger me-1"
                                   style="color:#ff6b35"></i>Item
                            </th>
                            <th>
                                <i class="fa-solid fa-hashtag me-1"
                                   style="color:#ff6b35"></i>Qty
                            </th>
                            <th>
                                <i class="fa-solid fa-tag me-1"
                                   style="color:#ff6b35"></i>Unit Price
                            </th>
                            <th>
                                <i class="fa-solid fa-calculator me-1"
                                   style="color:#ff6b35"></i>Subtotal
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.OrderItems)
                        {
                            <tr>
                                <td class="ps-3">@item.FoodName</td>
                                <td>@item.Quantity</td>
                                <td>৳@item.Price</td>
                                <td class="fw-bold">
                                    ৳@(item.Price* item.Quantity)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Order Footer -->
            <div class="card-footer border-0 bg-white px-4 py-3"
                 style="border-radius:0 0 15px 15px">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <!-- Payment Info -->
                        <span class="me-3">
                            @if (order.PaymentMethod == "Cash on Delivery")
                            {
                                <i class="fa-solid fa-money-bill me-1 text-success"></i>
                            }
                            else if (order.PaymentMethod == "bKash")
                            {
                                <i class="fa-solid fa-mobile-screen me-1"
                                   style="color:#E2136E"></i>
                            }
                            else if (order.PaymentMethod == "Nagad")
                            {
                                <i class="fa-solid fa-mobile-screen me-1"
                                   style="color:#F6A024"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-credit-card me-1 text-primary"></i>
                            }
                            <span class="text-muted">@order.PaymentMethod</span>
                        </span>

                        @if (order.PaymentStatus == "Paid")
                        {
                            <span class="badge bg-success">
                                <i class="fa-solid fa-circle-check me-1"></i>Paid
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="fa-solid fa-clock me-1"></i>Unpaid
                            </span>
                        }
                    </div>
                    <div class="col-md-6 text-end">
                        <span class="text-muted me-2">Order Total:</span>
                        <span class="fw-bold fs-5" style="color:#ff6b35">
                            ৳@order.Total
                        </span>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="mt-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Order Progress</small>
                    </div>
                    <div class="progress" style="height:8px; border-radius:10px">
                        @if (order.Status == "Pending")
                        {
                            <div class="progress-bar bg-warning" style="width:25%"></div>
                        }
                        else if (order.Status == "Preparing")
                        {
                            <div class="progress-bar bg-primary" style="width:65%"></div>
                        }
                        else if (order.Status == "Delivered")
                        {
                            <div class="progress-bar bg-success" style="width:100%"></div>
                        }
                        else if (order.Status == "Cancelled")
                        {
                            <div class="progress-bar bg-danger" style="width:100%"></div>
                        }
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">Placed</small>
                        <small class="text-muted">Preparing</small>
                        <small class="text-muted">Delivered</small>
                    </div>
                </div>
            </div>
        </div>
    }
}