@model List<BAL.DTOs.FoodDTO>
@{
    ViewData["Title"] = "Menu";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4"
         role="alert" style="border-radius:12px; border-left: 4px solid #28a745;">
        <i class="fa-solid fa-circle-check me-2 fs-5"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
        <i class="fa-solid fa-utensils me-2" style="color:#ff6b35"></i>
        Our Menu
    </h2>
</div>

<!-- Search Bar -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group">
        <span class="input-group-text" style="background:#ff6b35; color:white;">
            <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control" placeholder="Search food items..." />
        <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
        </button>
        @if (ViewBag.Search != null)
        {
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-xmark me-1"></i> Clear
            </a>
        }
    </div>
</form>

<!-- Category Filter -->
<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index"
       class="btn btn-sm @(ViewBag.SelectedCategory == null ? "text-white" : "btn-outline-secondary")"
       style="@(ViewBag.SelectedCategory == null ? "background:#ff6b35" : "")">
        <i class="fa-solid fa-border-all me-1"></i> All
    </a>
    @foreach (var cat in ViewBag.Categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.Id"
           class="btn btn-sm @(ViewBag.SelectedCategory == cat.Id ? "text-white" : "btn-outline-secondary")"
           style="@(ViewBag.SelectedCategory == cat.Id ? "background:#ff6b35" : "")">
            <i class="fa-solid fa-utensils me-1"></i> @cat.Name
        </a>
    }
</div>

<!-- Food Cards -->
@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="fa-solid fa-face-frown fa-3x mb-3 d-block"></i>
        <h5>No food items found</h5>
    </div>
}
else
{
    <div class="row">
        @foreach (var food in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card border-0 h-100"
                     style="border-radius:15px;
                            box-shadow:0 4px 20px rgba(0,0,0,0.08);
                            transition: transform 0.2s"
                     onmouseover="this.style.transform='translateY(-5px)'"
                     onmouseout="this.style.transform='translateY(0)'">

                    <!-- Food Image -->
                    @if (!string.IsNullOrEmpty(food.Image))
                    {
                        <img src="@food.Image" class="card-img-top"
                             style="height:200px; object-fit:cover;
                                    border-radius:15px 15px 0 0"
                             alt="@food.Name" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center"
                             style="height:200px; background:#fff3ee;
                                    border-radius:15px 15px 0 0">
                            <i class="fa-solid fa-burger fa-4x"
                               style="color:#ff6b35; opacity:0.4"></i>
                        </div>
                    }

                    <div class="card-body p-3">
                        <!-- Category Badge -->
                        <span class="badge bg-success mb-2">
                            <i class="fa-solid fa-utensils me-1"></i>
                            @food.CategoryName
                        </span>

                        <h5 class="fw-bold mb-1">@food.Name</h5>
                        <p class="text-muted small mb-3">
                            @(food.Description ?? "Delicious food item")
                        </p>

                        <div class="d-flex justify-content-between
                                    align-items-center">
                            <span class="fw-bold fs-5" style="color:#ff6b35">
                                ৳@food.Price
                            </span>
                            <a asp-controller="Cart" asp-action="Add"
                               asp-route-foodId="@food.Id"
                               class="btn btn-sm text-white"
                               style="background:#ff6b35; border-radius:8px">
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                Add to Cart
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}