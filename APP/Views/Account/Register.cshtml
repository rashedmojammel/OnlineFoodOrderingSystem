@model BAL.DTOs.RegisterDTO
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Register - Foodyy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f0f2f5;
    min-height: 100vh;
    display: flex;
    align-items: center;}
        .card { border-radius: 15px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
        .btn-custom { background: #ff6b35; border-color: #ff6b35; color:white; }
        .btn-custom:hover { background: #e55a25; border-color: #e55a25; color:white; }
        .brand { color: #ff6b35; font-weight: bold; font-size: 28px; }
        .form-control:focus { border-color: #ff6b35; box-shadow: 0 0 0 0.2rem rgba(255,107,53,0.25); }
        a { color: #ff6b35; }
        a:hover { color: #e55a25; }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card p-4">
                    <div class="text-center mb-4">
                        <div class="brand">🍔 Foodyy</div>
                        <p class="text-muted">Create your account</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                        </div>
                        <button type="submit" class="btn btn-custom w-100 mb-3">Create Account</button>
                        <div class="text-center">
                            <span class="text-muted">Already have an account? </span>
                            <a asp-action="Login">Login here</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>