@model BAL.DTOs.UserDTO
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="fa-solid fa-user-pen me-2" style="color:#ff6b35"></i>Edit Profile
        </h2>
        <p class="text-muted mb-0">Update your personal information</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Back
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert"
         style="border-radius:12px; border-left:4px solid #dc3545;">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0" style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">

            <!-- Card header with avatar -->
            <div class="card-header border-0 text-center py-4"
                 style="border-radius:15px 15px 0 0; background:linear-gradient(135deg,#ff6b35,#f7931e)">
                <div class="mb-2">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                         style="width:70px;height:70px;background:rgba(255,255,255,0.25)">
                        <i class="fa-solid fa-user fa-2x text-white"></i>
                    </div>
                </div>
                <h5 class="text-white fw-bold mb-0">@ViewBag.UserName</h5>
                <small class="text-white opacity-75">Customer Account</small>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />

                    <!-- Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">
                            <i class="fa-solid fa-user me-1" style="color:#ff6b35"></i>Full Name
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">
                            <i class="fa-solid fa-envelope me-1" style="color:#ff6b35"></i>Email Address
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password (optional change) -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">
                            <i class="fa-solid fa-lock me-1" style="color:#ff6b35"></i>New Password
                        </label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control"
                                   placeholder="Leave blank to keep current password" id="passwordInput" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword()">
                                <i class="fa-solid fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Role hidden (don't let customer change their own role) -->
                    <input asp-for="Role" type="hidden" value="Customer" />

                    <hr class="my-4" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn text-white px-4 fw-bold"
                                style="background:#ff6b35; border-color:#ff6b35">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // Focus ring to match brand color
        document.querySelectorAll('.form-control').forEach(el => {
            el.addEventListener('focus', () => el.style.borderColor = '#ff6b35');
            el.addEventListener('blur',  () => el.style.borderColor = '');
        });
    </script>
}