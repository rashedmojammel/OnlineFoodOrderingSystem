@{
    ViewData["Title"] = "Customer Dashboard";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4"
         role="alert" style="border-radius:12px; border-left: 4px solid #28a745;">
        <i class="fa-solid fa-circle-check me-2 fs-5"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Welcome Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="fa-solid fa-house me-2" style="color:#ff6b35"></i>My Dashboard
        </h2>
        <p class="text-muted mb-0 text-center">
            Welcome back, <strong style="color:#ff6b35">@ViewBag.UserName</strong> 
        </p>
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 text-white"
             style="border-radius:15px; background:linear-gradient(135deg,#28a745,#20c997)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Total Orders</p>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalOrders</h3>
                </div>
                <i class="fa-solid fa-clipboard-list fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 text-white"
             style="border-radius:15px; background:linear-gradient(135deg,#ff6b35,#f7931e)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Cart Items</p>
                    <h3 class="fw-bold mb-0">@ViewBag.CartItems</h3>
                </div>
                <i class="fa-solid fa-cart-shopping fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 text-white"
             style="border-radius:15px; background:linear-gradient(135deg,#007bff,#6610f2)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Pending Orders</p>
                    <h3 class="fw-bold mb-0">@ViewBag.PendingOrders</h3>
                </div>
                <i class="fa-solid fa-clock fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Quick Action Cards -->
<h5 class="fw-bold mb-3">
    <i class="fa-solid fa-bolt me-2" style="color:#ff6b35"></i>Quick Actions
</h5>
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 h-100"
             style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
            <div class="card-body text-center p-4">
                <div class="mb-3 rounded-circle d-inline-flex align-items-center
                    justify-content-center"
                     style="width:65px; height:65px; background:#eaffee">
                    <i class="fa-solid fa-utensils fa-2x text-success"></i>
                </div>
                <h5 class="fw-bold">Browse Menu</h5>
                <p class="text-muted small">
                    Explore our delicious food items and place your order
                </p>
                <a asp-controller="Menu" asp-action="Index"
                       class="btn btn-success w-100">
                    <i class="fa-solid fa-arrow-right me-1"></i> Order Now
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 h-100"
             style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
            <div class="card-body text-center p-4">
                <div class="mb-3 rounded-circle d-inline-flex align-items-center
                    justify-content-center"
                     style="width:65px; height:65px; background:#fff3ee">
                    <i class="fa-solid fa-cart-shopping fa-2x"
                       style="color:#ff6b35"></i>
                </div>
                <h5 class="fw-bold">My Cart</h5>
                <p class="text-muted small">
                    View your cart items and proceed to checkout
                </p>
                <a asp-controller="Cart" asp-action="Index"
                       class="btn w-100 text-white" style="background:#ff6b35">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Cart
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 h-100"
             style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
            <div class="card-body text-center p-4">
                <div class="mb-3 rounded-circle d-inline-flex align-items-center
                    justify-content-center"
                     style="width:65px; height:65px; background:#eef3ff">
                    <i class="fa-solid fa-box fa-2x text-primary"></i>
                </div>
                <h5 class="fw-bold">My Orders</h5>
                <p class="text-muted small">
                    Track your current and past orders
                </p>
                <a asp-controller="Order" asp-action="MyOrders"
                       class="btn btn-primary w-100">
                    <i class="fa-solid fa-arrow-right me-1"></i> Track Orders
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="card border-0 mb-4"
     style="border-radius:15px; box-shadow:0 4px 20px rgba(0,0,0,0.08)">
    <div class="card-header border-0 d-flex justify-content-between align-items-center"
         style="background:white; border-radius:15px 15px 0 0">
        <h5 class="fw-bold mb-0">
            <i class="fa-solid fa-clock-rotate-left me-2"
               style="color:#ff6b35"></i>Recent Orders
        </h5>
        <a asp-controller="Order" asp-action="MyOrders"
               class="btn btn-sm text-white" style="background:#ff6b35">
            <i class="fa-solid fa-eye me-1"></i> View All
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#f8f9fa">
                <tr>
                    <th class="ps-4">
                        <i class="fa-solid fa-hashtag me-1"></i>Order ID
                    </th>
                    <th><i class="fa-solid fa-calendar me-1"></i>Date</th>
                    <th><i class="fa-solid fa-money-bill me-1"></i>Total</th>
                    <th><i class="fa-solid fa-circle-info me-1"></i>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
                {
                    @foreach (var order in ViewBag.RecentOrders)
                    {
                        <tr>
                            <td class="ps-4">#@order.Id</td>
                            <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                            <td>৳@order.Total</td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa-solid fa-clock me-1"></i>Pending
                                    </span>
                                }
                                else if (order.Status == "Preparing")
                                {
                                    <span class="badge bg-primary">
                                        <i class="fa-solid fa-fire me-1"></i>Preparing
                                    </span>
                                }
                                else if (order.Status == "Delivered")
                                {
                                    <span class="badge bg-success">
                                        <i class="fa-solid fa-circle-check me-1"></i>Delivered
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                            No orders yet —
                            <a asp-controller="Menu" asp-action="Index"
                                   style="color:#ff6b35">
                                Order now!
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
       
    </div>
</div>